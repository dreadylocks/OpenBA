<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for OpenBA (docs/reference/code_signing.md).
  SignPath keeps its own copy: paste this into the project's artifact configuration when it is
  created, and paste it again whenever this file changes. The repository copy is the reference.

  The GitHub artifact `unsigned-exe` (.github/workflows/release.yml) is a zip holding OpenBA.exe at
  its root. SignPath Foundation's terms ask every signed binary to carry the project name as its
  product name and the release's version: src/app/version.rc.in writes both from CMakeLists.txt's
  project(... VERSION), and the workflow passes that version as the `version` parameter.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OpenBA.exe" product-name="OpenBA" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
